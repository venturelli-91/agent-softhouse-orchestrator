# Executor v1: the Claude Code login already on the machine (subscription). No key here.
EXECUTOR=claude-subscription
AGENTS_DIR=../.claude/agents

# Model/effort: single source. Per-role override: MODEL_DEV, EFFORT_QA, ...
# Valid names and levels: see `claude --help` and the official docs (CLI reference).
MODEL_DEFAULT=claude-sonnet-5-5
EFFORT_DEFAULT=medium
# Cheaper model for the read-only nodes (measured: ~78% less US$ per ticket, see docs 07-metrics). Dev and planner keep the default.
# MODEL_TRIAGE: Haiku marks clear requests as unclear (see 08-real-repo-validation.md), keep the default model
MODEL_REVIEWER=claude-haiku-5-5
MODEL_QA=claude-haiku-5-5
MODEL_DEVOPS=claude-haiku-5-5
# Optional: dev passed 12/12 on Haiku at 1/13 of the cost on small tickets (docs 08); try MODEL_DEV=claude-haiku-5-5 and watch revisions

# Working turns per node (the orchestrator adds +1 for the structured output).
TURNS_DEFAULT=8
TURNS_TRIAGE=3
TURNS_PLANNER=8
TURNS_REVIEWER=6
TURNS_QA=8
TURNS_DEV=15
TURNS_DEVOPS=6
TURNS_WATCHDOG=6

# Per-ticket token budget (input+output); exceeding it = interrupt() to the CEO.
TOKEN_BUDGET_TICKET=200000

# Who pushes and opens the (draft) PR: github | none. Missing = failure.
PUBLISHER=none

# Rolling 24h cap on tokens (input+output+cache) across all tickets and repos, to keep the subscription's 5h limit from
# running out mid-ticket. Unset = no cap. Tune it from `orch status` after a few days; calls stop (escalate) once reached.
TOKEN_CAP_DAILY=1500000

# Optional push for "waiting for you" (approval/escalation): plain-text POST, e.g. https://ntfy.sh/<hard-to-guess-topic>
# NOTIFY_URL=
