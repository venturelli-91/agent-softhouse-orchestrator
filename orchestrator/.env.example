# Executor v1: login do Claude Code ja existente na maquina (plano). Nenhuma chave aqui.
EXECUTOR=claude-subscription
AGENTS_DIR=../.claude/agents

# Modelo/esforco: unica fonte. Override por papel: MODEL_DEV, EFFORT_QA, ...
# Nomes e niveis validos: ver `claude --help` e a doc oficial (CLI reference).
MODEL_DEFAULT=claude-sonnet-5-5
EFFORT_DEFAULT=medium

# Turnos de trabalho por no (o orquestrador soma +1 do structured output).
TURNOS_DEFAULT=8
TURNOS_TRIAGEM=3
TURNOS_PLANEJADOR=8
TURNOS_REVIEWER=6
TURNOS_QA=8
TURNOS_DEV=15
TURNOS_DEVOPS=6
TURNOS_WATCHDOG=6

# Orcamento de tokens por ticket (entrada+saida); estourou = interrupt() para o CEO.
TOKEN_BUDGET_TICKET=200000

# Quem faz push e abre o PR (rascunho): github | nenhum. Ausente = falha.
PUBLICADOR=nenhum
